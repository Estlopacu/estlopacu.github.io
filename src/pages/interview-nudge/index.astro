---
import '../../styles/global.css';

const PLAY_URL = null; // set to 'https://play.google.com/store/apps/details?id=com.estlopacu.interviewNudge' once public
const BETA_URL = 'https://play.google.com/apps/testing/com.estlopacu.interviewNudge';
const ctaHref = PLAY_URL ?? BETA_URL;
const ctaLabel = PLAY_URL ? 'Get it on Google Play' : 'Join the beta';

const screenshots = [
  { file: '01-home.png',          alt: 'Topics list showing System Design, Security & Auth, and other built-in decks' },
  { file: '02-concept.png',       alt: 'Concept detail screen with Forgot and Knew it buttons' },
  { file: '03-progress.png',      alt: 'Progress screen showing streak, review heatmap, and mastery per topic' },
  { file: '04-nudges.png',        alt: 'Recent nudges list showing notification history' },
  { file: '05-topic-settings.png',alt: 'Topic settings: times per day, active hours, days, and notification sound' },
  { file: '06-dark-concept.png',  alt: 'Concept detail in dark theme' },
];
---

<!DOCTYPE html>
<html lang="en" data-theme="terminal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/interview-nudge/icon-512.png" />
    <title>Interview Nudge: interview concepts, one notification at a time</title>
    <meta name="description" content="Stay interview-ready: bite-size concepts delivered as notifications all day. Spaced repetition on Android, no account required." />
    <link rel="canonical" href="https://estlopacu.github.io/interview-nudge/" />

    <meta property="og:title" content="Interview Nudge: interview concepts, one notification at a time" />
    <meta property="og:description" content="Stay interview-ready: bite-size concepts delivered as notifications all day." />
    <meta property="og:image" content="https://estlopacu.github.io/interview-nudge/feature-graphic.png" />
    <meta property="og:url" content="https://estlopacu.github.io/interview-nudge/" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Interview Nudge: interview concepts, one notification at a time" />
    <meta name="twitter:description" content="Stay interview-ready: bite-size concepts delivered as notifications all day." />
    <meta name="twitter:image" content="https://estlopacu.github.io/interview-nudge/feature-graphic.png" />
  </head>

  <body>
    <header class="in-nav">
      <a class="in-nav__home" href="/">← estlopacu.github.io</a>
    </header>

    <main>
      <!-- Hero -->
      <section class="in-hero">
        <!-- Deck of cards — first in DOM so it appears top on mobile -->
        <div class="in-deck reveal" style="transition-delay:.12s" id="cardDeck" aria-label="App screenshots — tap to flip through">
          {screenshots.map(({ file, alt }, i) => (
            <div class="in-deck__card" data-index={i} role="img" aria-label={alt}>
              <div class="in-phone-frame">
                <img
                  src={`/interview-nudge/screenshots/${file}`}
                  width="1080" height="2160"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  alt={alt}
                />
              </div>
            </div>
          ))}
          <p class="in-deck__hint">tap to flip</p>
        </div>

        <div class="in-hero__copy">
          <div class="in-hero__identity reveal">
            <img class="in-hero__icon bell-ring" src="/interview-nudge/icon-512.png" width="96" height="96" alt="Interview Nudge app icon" />
            <h1 class="in-hero__title">Interview Nudge</h1>
          </div>
          <p class="in-hero__audience reveal" style="transition-delay:.04s">For software engineers preparing for tech interviews</p>
          <p class="in-hero__sub reveal" style="transition-delay:.08s">Stop cramming the night before. Interview Nudge sends short pop-up reminders to your phone throughout the day — each one covering a concept that might come up in your interview.</p>
          <p class="in-hero__cmd reveal" aria-hidden="true" style="transition-delay:.16s"><span class="in-prompt">nudge:~$</span> recall --daily</p>
          <div class="in-hero__cta reveal" style="transition-delay:.24s">
            <a class="in-btn in-btn--primary" href={ctaHref}>{ctaLabel}</a>
            {!PLAY_URL && <p class="in-hero__beta-note">Android · closed beta on Google Play</p>}
          </div>
        </div>
      </section>

      <!-- How it works -->
      <section class="in-section">
        <p class="in-eyebrow reveal"><span class="in-eyebrow__muted">// </span>HOW IT WORKS</p>
        <h2 class="in-section__title reveal" style="transition-delay:.06s">Three steps, all day long</h2>
        <ol class="in-steps">
          <li class="in-step reveal" style="transition-delay:.12s">
            <span class="in-step__num">01</span>
            <div>
              <strong>A reminder pops up on your phone</strong>
              <p>A concept name and a short hint appear on your screen — like a text message alert. Try to recall the answer before you tap.</p>
            </div>
          </li>
          <li class="in-step reveal" style="transition-delay:.2s">
            <span class="in-step__num">02</span>
            <div>
              <strong>Read the full explanation</strong>
              <p>Tap to open the concept detail with the complete explanation.</p>
            </div>
          </li>
          <li class="in-step reveal" style="transition-delay:.28s">
            <span class="in-step__num">03</span>
            <div>
              <strong>Rate your recall</strong>
              <p>Tap "Knew it" or "Forgot" right from the reminder. The app uses spaced repetition — a learning technique that shows you forgotten concepts more often and gradually spaces out the ones you've mastered — so you retain more with less effort.</p>
            </div>
          </li>
        </ol>
      </section>

      <!-- Decks -->
      <section class="in-section">
        <p class="in-eyebrow reveal"><span class="in-eyebrow__muted">// </span>CONCEPT DECKS</p>
        <h2 class="in-section__title reveal" style="transition-delay:.06s">Built-in decks, ready on day one</h2>
        <p class="in-decks__intro reveal" style="transition-delay:.08s">These are the topics that come up most in software engineering interviews — from Google and Meta to startup on-sites.</p>
        <ul class="in-decks">
          <li class="reveal" style="transition-delay:.10s">System Design</li>
          <li class="reveal" style="transition-delay:.16s">Security &amp; Auth</li>
          <li class="reveal" style="transition-delay:.22s">Architecture Patterns</li>
          <li class="reveal" style="transition-delay:.28s">DSA Patterns</li>
          <li class="reveal" style="transition-delay:.34s">Behavioral</li>
        </ul>
        <p class="in-decks__addendum reveal" style="transition-delay:.40s">Add your own topics and concepts</p>
      </section>

      <!-- Features -->
      <section class="in-section">
        <p class="in-eyebrow reveal"><span class="in-eyebrow__muted">// </span>FEATURES</p>
        <h2 class="in-section__title reveal" style="transition-delay:.06s">What's under the hood</h2>
        <ul class="in-features">
          <li class="reveal" style="transition-delay:.10s"><span class="in-feature__label">Spaced repetition</span> — forgotten concepts come back sooner; known ones get spaced out.</li>
          <li class="reveal" style="transition-delay:.18s"><span class="in-feature__label">Progress</span> — daily streak, review heatmap, and mastery per topic.</li>
          <li class="reveal" style="transition-delay:.26s"><span class="in-feature__label">Per-topic schedule</span> — set how many times a day, active hours, which days, and alert sound for each deck.</li>
          <li class="reveal" style="transition-delay:.34s"><span class="in-feature__label">Light and dark theme</span> — follows your system preference or set it manually.</li>
        </ul>
      </section>

      <!-- Privacy -->
      <section class="in-section in-section--callout">
        <p class="in-eyebrow reveal"><span class="in-eyebrow__muted">// </span>PRIVATE BY DESIGN</p>
        <h2 class="in-section__title reveal" style="transition-delay:.06s">No account, no ads, no tracking.</h2>
        <p class="in-privacy__body reveal" style="transition-delay:.12s">Everything stays on your phone. The app doesn't even need an internet connection.</p>
        <a class="in-privacy__link reveal" style="transition-delay:.18s" href="/interview-nudge/privacy/">Read the full privacy policy →</a>
      </section>
    </main>

    <footer class="in-footer reveal">
      <p>Questions or feedback: <a href="mailto:estlopacu@gmail.com">estlopacu@gmail.com</a></p>
      <p><a href="/">← estlopacu.github.io</a></p>
    </footer>

    <script>
      // Scroll reveal
      (function () {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });

        // Hero elements are above the fold — show immediately
        document.querySelectorAll('.in-hero .reveal').forEach(el => {
          el.classList.add('in-view');
        });
        // Everything else observes on scroll
        document.querySelectorAll('.reveal:not(.in-hero .reveal)').forEach(el => io.observe(el));
      })();

      // Deck of cards
      (function () {
        const deck = document.getElementById('cardDeck');
        if (!deck) return;

        // Cards in DOM order = index 0 is first screenshot (renders on top via z-index from data-depth)
        const cards = Array.from(deck.querySelectorAll('.in-deck__card'));
        const total = cards.length;
        // order[0] = index of card currently on top
        const order = cards.map((_, i) => i);

        function applyDepths() {
          order.forEach((cardIdx, depth) => {
            const card = cards[cardIdx];
            card.setAttribute('data-depth', depth);
            // stack order: depth 0 on top
            card.style.zIndex = total - depth;
          });
        }

        applyDepths();

        let animating = false;
        function flyOff(direction) {
          if (animating) return;
          animating = true;
          const topIdx = order[0];
          const topCard = cards[topIdx];
          topCard.classList.add(direction === 'left' ? 'in-deck__card--fly-left' : 'in-deck__card--fly-right');

          setTimeout(() => {
            topCard.classList.remove('in-deck__card--fly-left', 'in-deck__card--fly-right');
            order.push(order.shift());
            applyDepths();
            animating = false;
          }, 420);
        }

        // Tap + drag/swipe via pointer events only — avoids click-event routing
        // issues caused by setPointerCapture in Chrome (click fires on capture
        // target, not on the card, so card-level click listeners never fire).
        let flyDir = 'left';
        let dragStartX = 0;
        let dragging = false;
        deck.addEventListener('pointerdown', (e) => {
          dragStartX = e.clientX;
          dragging = true;
          try { e.currentTarget.setPointerCapture(e.pointerId); } catch (_) {}
        });
        deck.addEventListener('pointerup', (e) => {
          if (!dragging) return;
          dragging = false;
          const dx = e.clientX - dragStartX;
          if (Math.abs(dx) > 40) {
            flyOff(dx < 0 ? 'left' : 'right');
            flyDir = dx < 0 ? 'right' : 'left';
          } else {
            flyOff(flyDir);
            flyDir = flyDir === 'left' ? 'right' : 'left';
          }
        });
        deck.addEventListener('pointercancel', () => { dragging = false; });
      })();
    </script>
  </body>
</html>

<style>
  /* ── Layout shell ─────────────────────────────────────────── */
  body {
    background: var(--surface-page);
    margin: 0;
    color: var(--text-body);
    font-family: var(--font-body);
  }

  /* ── Nav ──────────────────────────────────────────────────── */
  .in-nav {
    display: flex;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .in-nav__home {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
  }
  .in-nav__home:hover { color: var(--text-terminal); }

  /* ── Shared section chrome ────────────────────────────────── */
  .in-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 64px 24px;
    border-top: 1px solid var(--border-subtle);
  }
  .in-section--callout {
    border-left: 3px solid var(--border-brand);
    background: color-mix(in srgb, var(--brand) 6%, transparent);
    border-radius: 4px;
    margin: 0 auto 0;
  }

  .in-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-terminal);
    margin: 0 0 8px;
  }
  .in-eyebrow__muted { color: var(--text-muted); }

  .in-section__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 4vw, 32px);
    color: var(--text-strong);
    line-height: 1.2;
    margin: 0 0 32px;
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .in-hero {
    max-width: 1100px;
    margin: 0 auto;
    padding: 72px 24px 64px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .in-hero__identity {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
  }

  .in-hero__icon {
    width: 96px;
    height: 96px;
    border-radius: 20px;
    flex-shrink: 0;
  }

  .in-hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 5vw, 52px);
    color: var(--text-strong);
    line-height: 1.1;
    margin: 0;
  }

  .in-hero__audience {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-terminal);
    margin: 0 0 14px;
    padding: 5px 10px;
    border: 1px solid var(--border-brand);
    border-radius: 4px;
    display: inline-block;
  }

  .in-hero__sub {
    font-size: clamp(16px, 2.2vw, 20px);
    color: var(--text-body);
    line-height: 1.55;
    margin: 0 0 24px;
    max-width: 480px;
  }

  .in-hero__cmd {
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text-terminal);
    margin: 0 0 32px;
    letter-spacing: 0.03em;
  }
  .in-prompt {
    color: var(--text-muted);
    margin-right: 6px;
  }

  .in-hero__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .in-hero__beta-note {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Deck of cards ────────────────────────────────────────── */

  /* On desktop: deck is first in DOM but should appear in column 2 */
  .in-hero__copy { order: 1; }
  .in-deck       { order: 2; }

  .in-deck {
    position: relative;
    width: 240px;
    /* height driven by aspect ratio of cards — 240 * 2 + room for peeking cards */
    height: 524px;
    justify-self: center;
    flex-shrink: 0;
  }

  .in-deck__card {
    position: absolute;
    top: 0;
    left: 0;
    width: 240px;
    border-radius: 28px;
    overflow: hidden;
    border: 2px solid var(--border-strong);
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    cursor: pointer;
    transform-origin: bottom center;
    will-change: transform;
    transition: transform 0.35s cubic-bezier(.22,.68,0,1.2), opacity 0.3s;
    user-select: none;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Cards behind the top one peek out with rotation + offset */
  .in-deck__card[data-depth="1"] { transform: rotate(4deg)  translateY(10px); }
  .in-deck__card[data-depth="2"] { transform: rotate(-5deg) translateY(18px); }
  .in-deck__card[data-depth="3"] { transform: rotate(3deg)  translateY(26px); }
  .in-deck__card[data-depth="4"] { transform: rotate(-4deg) translateY(32px); }
  .in-deck__card[data-depth="5"] { transform: rotate(2deg)  translateY(36px); }

  /* Top card: flat, no rotation */
  .in-deck__card[data-depth="0"] {
    transform: rotate(0deg) translateY(0);
    cursor: pointer;
    z-index: 10;
  }
  .in-deck__card[data-depth="0"]:hover {
    transform: rotate(0deg) translateY(-6px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
  }

  /* Flying-off animation */
  .in-deck__card--fly-left  { transform: translateX(-140%) rotate(-18deg) !important; opacity: 0 !important; transition: transform 0.4s ease-in, opacity 0.35s ease-in !important; }
  .in-deck__card--fly-right { transform: translateX(140%)  rotate(18deg)  !important; opacity: 0 !important; transition: transform 0.4s ease-in, opacity 0.35s ease-in !important; }

  .in-phone-frame {
    width: 100%;
    overflow: hidden;
  }
  .in-phone-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .in-deck__hint {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    margin: 0;
    letter-spacing: 0.08em;
    pointer-events: none;
  }

  /* ── Button ───────────────────────────────────────────────── */
  .in-btn {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 6px;
    letter-spacing: 0.02em;
    transition: opacity 0.15s;
  }
  .in-btn:hover { opacity: 0.85; }
  .in-btn--primary {
    background: var(--brand);
    color: var(--text-inverse);
  }

  /* ── How it works ─────────────────────────────────────────── */
  .in-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .in-step {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .in-step__num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-terminal);
    min-width: 28px;
    padding-top: 2px;
  }
  .in-step strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-strong);
    margin-bottom: 4px;
  }
  .in-step p { margin: 0; line-height: 1.6; }

  /* ── Decks ────────────────────────────────────────────────── */
  .in-decks {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .in-decks li {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-strong);
    padding: 10px 16px;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    background: var(--surface-card);
  }
  .in-decks li::before {
    content: '$ ';
    color: var(--text-terminal);
  }
  .in-decks__intro {
    font-size: 15px;
    color: var(--text-body);
    margin: 0 0 20px;
    line-height: 1.6;
  }

  .in-decks__addendum {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── Features ─────────────────────────────────────────────── */
  .in-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .in-features li {
    padding-left: 20px;
    border-left: 2px solid var(--border-subtle);
    line-height: 1.6;
  }
  .in-feature__label {
    color: var(--text-strong);
    font-weight: 600;
  }

  /* ── Privacy callout ──────────────────────────────────────── */
  .in-privacy__body {
    color: var(--text-body);
    margin: 0 0 16px;
    line-height: 1.6;
  }
  .in-privacy__link {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .in-privacy__link:hover { color: var(--brand-bright); }

  /* ── Scroll reveal ───────────────────────────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.55s cubic-bezier(.16,1,.3,1),
                transform 0.55s cubic-bezier(.16,1,.3,1);
  }
  .reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Footer ───────────────────────────────────────────────── */
  .in-footer {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px 24px 56px;
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
  }
  .in-footer p { margin: 6px 0; }
  .in-footer a {
    color: var(--text-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .in-footer a:hover { color: var(--brand-bright); }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 768px) {
    .in-hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 48px 16px 48px;
    }
    /* Reset desktop order — DOM order takes over (deck first) */
    .in-hero__copy { order: 2; }
    .in-deck       { order: 1; width: 180px; height: 394px; }
    .in-deck__card { width: 180px; }
    .in-section {
      padding: 48px 16px;
    }
  }

  @media (max-width: 480px) {
    .in-hero__icon {
      width: 72px;
      height: 72px;
    }
  }
</style>
