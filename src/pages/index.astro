---
import App from '../components/App.jsx';
import '../styles/global.css';
---

<!doctype html>
<html lang="en" data-theme="terminal">
  <head>
    <script is:inline>
      (function () {
        const STORE_KEY = 'estlopacu-theme';
        const MIGRATION_KEY = 'estlopacu-theme-migrated-v2-terminal-default';
        try {
          if (
            localStorage.getItem(MIGRATION_KEY) &&
            localStorage.getItem(STORE_KEY) === 'light'
          ) {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch {
          // localStorage unavailable (private browsing restriction)
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      as="image"
      href="/profile-bg-removed.webp"
      type="image/webp"
      fetchpriority="high"
    />
    <title>Luis Esteban López Acuña — Software Engineer</title>
    <meta
      name="description"
      content="Senior full-stack engineer from Costa Rica, based in Berlin. 10+ years delivering high-impact products for startups and scale-ups. React, Next.js, TypeScript."
    />
    <meta name="author" content="Luis Esteban López Acuña" />
    <meta
      property="og:title"
      content="Luis Esteban López Acuña — Software Engineer"
    />
    <meta
      property="og:description"
      content="Senior full-stack engineer from Costa Rica, based in Berlin. 10+ years delivering high-impact products."
    />
    <meta
      property="og:image"
      content="https://estlopacu.github.io/profile-bg-removed.png"
    />
    <meta property="og:url" content="https://estlopacu.github.io" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Luis Esteban López Acuña — Software Engineer"
    />
    <meta
      name="twitter:description"
      content="Senior full-stack engineer from Costa Rica, based in Berlin. 10+ years delivering high-impact products."
    />
    <meta
      name="twitter:image"
      content="https://estlopacu.github.io/profile-bg-removed.png"
    />
    <link rel="canonical" href="https://estlopacu.github.io" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Luis Esteban López Acuña',
        jobTitle: 'Software Engineer',
        email: 'estlopacu@gmail.com',
        url: 'https://estlopacu.github.io',
        image: 'https://estlopacu.github.io/profile-bg-removed.png',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Berlin',
          addressCountry: 'DE',
        },
        sameAs: [
          'https://github.com/Estlopacu',
          'https://www.linkedin.com/in/estlopacu/',
        ],
      })}
    />
  </head>
  <body>
    <a href="#about" class="pf-skip-link">
      Skip to main content
    </a>
    <div id="root">
      <App client:load />
    </div>
  </body>
</html>
